---
import { Picture } from "astro:assets";
import microscope from "../assets/img/microscope.webp";
import Icon from "./Icon.astro";
import { phones, messengers, address, directions } from "../data/clinic";
const index = directions.map((d, i) => (i === 0 ? d.name : d.name.charAt(0).toLowerCase() + d.name.slice(1)));
---
<section id="top" class="hero" data-rec="R-002, R-010, R-013, G-R005, G-R006, MA-R005" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">
        <span class="settle" style="--i:0">Стоматологія</span>
        <span class="settle" style="--i:1">повного циклу</span>
        <span class="settle" style="--i:2">на Сихові</span>
      </h1>
      <p class="hero__where">
        {address.street} — <span class="nowrap">{address.hours}</span>
        <a class="text-link hero__route" href={address.map} rel="noopener" target="_blank">Маршрут<span class="visually-hidden"> (Google Карти, нове вікно)</span></a>
      </p>

      <div class="hero__actions settle" style="--i:3" data-rec="R-004, MA-R006">
        <a class="call" href={phones.main.href}>
          <span class="call__label"><Icon name="phone" />Подзвонити</span>
          <span class="call__number">{phones.main.text}</span>
        </a>
        <div class="hero__side">
          <ul class="msgs" role="list" aria-label="Написати в месенджер">
            {messengers.map((m) => (
              <li><a class="msg" href={m.href} rel="noopener" target={m.id === "viber" ? undefined : "_blank"}><Icon name={m.id} /><span>{m.label}</span></a></li>
            ))}
          </ul>
          <p class="hero__second">Другий номер: <a class="text-link" href={phones.second.href}>{phones.second.text}</a></p>
        </div>
      </div>
    </div>

    <figure class="hero__photo">
      <Picture
        src={microscope}
        formats={["avif", "webp"]} fallbackFormat="webp"
        widths={[172, 344]}
        sizes="(min-width: 60rem) 300px, 1px"
        alt="Лікар VAV Dental працює з дентальним мікроскопом"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>Дентальний мікроскоп, збільшення від 30×</figcaption>
    </figure>

    <p class="hero__index">
      <a class="hero__index-lead" href="#poslugy">Десять напрямів</a>: {index.join(", ")}.
    </p>
  </div>
</section>
